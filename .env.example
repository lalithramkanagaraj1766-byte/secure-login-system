# Copy this file to ".env" and set your own values. Never commit ".env".
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Set to 1 only when the site runs over HTTPS (makes the session cookie "Secure")
COOKIE_SECURE=0

# Set to 1 for Flask debug mode (development only)
FLASK_DEBUG=0
